# Copy the values into your MCP client's server "env" block. Never commit real credentials.
ZIMBRA_IMAP_HOST=mail.example.com
ZIMBRA_SMTP_HOST=mail.example.com
ZIMBRA_USERNAME=you@example.com
ZIMBRA_PASSWORD=use-an-app-specific-password
ZIMBRA_CALDAV_URL=https://mail.example.com/dav/you@example.com/Calendar

# Optional
# ZIMBRA_IMAP_PORT=993
# ZIMBRA_SMTP_PORT=587
# ZIMBRA_TIMEOUT=30
# ZIMBRA_LOG_LEVEL=INFO
# ZIMBRA_STATE_DIR=~/.zimbra-mcp

# User SOAP endpoint (needed for folders/tags/contacts/events/tasks tools). Never the admin one.
# ZIMBRA_SOAP_URL=https://mail.example.com/service/soap

# Writes are OFF unless you opt in; sending additionally needs ZIMBRA_ALLOW_SEND.
# ZIMBRA_ALLOW_WRITE=true

# Sending is OFF unless you opt in. Prefer an allowlist of addresses or @domains.
# ZIMBRA_ALLOW_SEND=true
# ZIMBRA_SEND_ALLOWLIST=colleague@example.com,@example.com
