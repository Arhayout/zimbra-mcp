# Zimbra SOAP primary backend
ZIMBRA_URL=https://mail.example.com
ZIMBRA_USERNAME=user@example.com
ZIMBRA_PASSWORD=change-me
ZIMBRA_REQUEST_TIMEOUT=20
ZIMBRA_VERIFY_TLS=true
CALDAV_URL=https://mail.example.com/dav/user@example.com/Calendar

# IMAP/SMTP fallback backend
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_SSL=true
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SSL=true

# Sending is deliberately disabled unless explicitly enabled.
ZIMBRA_ENABLE_SEND=false
ZIMBRA_ENABLE_WRITE=false
ZIMBRA_ENABLE_ADMIN=false
# Admin SOAP uses https://<host>/service/admin/soap and the same credentials.
ZIMBA_STATE_DB=~/.local/share/zimbra-mcp/state.sqlite3
